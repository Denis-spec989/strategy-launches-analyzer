# Диффов и contract issues нет. Ожидаемо: totalDiffs = 0,
# deterministicSeverity = INFO. LLM всё равно вызывается (short-circuit не вводился).
POST {{baseUrl}}/api/v1/strategies/compare
Content-Type: application/json

{
  "strategy": "LGD_DIGITAL",
  "mainLaunch": {
    "strategyResponse": {
      "lgdData": {
        "lgd": 18.1,
        "lgdModel": "Corporate clients 2022",
        "lgdDt": 18.1
      },
      "calculationInfo": {
        "mode": "DEAL",
        "type": "ONLINE",
        "scenario": "LGD_CALCULATION_FOR_FZHN",
        "usedDefaultValue": true,
        "defaultValueReason": "LGD_CALCULATION_FOR_FZHN"
      }
    }
  },
  "shadowLaunch": {
    "strategyResponse": {
      "lgdData": {
        "lgd": 18.1,
        "lgdModel": "Corporate clients 2022",
        "lgdDt": 18.1
      },
      "calculationInfo": {
        "mode": "DEAL",
        "type": "ONLINE",
        "scenario": "LGD_CALCULATION_FOR_FZHN",
        "usedDefaultValue": true,
        "defaultValueReason": "LGD_CALCULATION_FOR_FZHN"
      }
    }
  },
  "metadata": {
    "requestId": "REQ-7",
    "mainLaunchId": "MAIN-7",
    "shadowLaunchId": "SHADOW-7"
  }
}


### 8. Bad request (400): отсутствует mainLaunch.strategyResponse
# Ожидаемо: 400, ErrorResponse{status:400, message:"mainLaunch.strategyResponse object is required."}.
POST {{baseUrl}}/api/v1/strategies/compare
Content-Type: application/json

{
  "strategy": "LGD_DIGITAL",
  "mainLaunch": {},
  "shadowLaunch": {
    "strategyResponse": {
      "lgdData": {
        "lgd": 18.1,
        "lgdModel": "Corporate clients 2022",
        "lgdDt": 18.1
      },
      "calculationInfo": {
        "mode": "DEAL",
        "type": "ONLINE",
        "scenario": "LGD_CALCULATION_FOR_FZHN",
        "usedDefaultValue": true,
        "defaultValueReason": "LGD_CALCULATION_FOR_FZHN"
      }
    }
  }
}


### 9. Bad request (400): тело не является валидным JSON
# Ожидаемо: 400, ErrorResponse{status:400, message:"Request body must be valid JSON."}.
POST {{baseUrl}}/api/v1/strategies/compare
Content-Type: application/json

{
  "strategy": "LGD_DIGITAL",
  "mainLaunch":
}


### 10. Bad request (400): неизвестная стратегия
# Ожидаемо: 400, message:"strategy must be one of: LGD_DIGITAL.".
POST {{baseUrl}}/api/v1/strategies/compare
Content-Type: application/json

{
  "strategy": "UNKNOWN_STRATEGY",
  "mainLaunch": {
    "strategyResponse": {
      "lgdData": { "lgd": 18.1, "lgdModel": "Corporate clients 2022", "lgdDt": 18.1 },
      "calculationInfo": {
        "mode": "DEAL",
        "type": "ONLINE",
        "scenario": "LGD_CALCULATION_FOR_FZHN",
        "usedDefaultValue": true,
        "defaultValueReason": "LGD_CALCULATION_FOR_FZHN"
      }
    }
  },
  "shadowLaunch": {
    "strategyResponse": {
      "lgdData": { "lgd": 18.1, "lgdModel": "Corporate clients 2022", "lgdDt": 18.1 },
      "calculationInfo": {
        "mode": "DEAL",
        "type": "ONLINE",
        "scenario": "LGD_CALCULATION_FOR_FZHN",
        "usedDefaultValue": true,
        "defaultValueReason": "LGD_CALCULATION_FOR_FZHN"
      }
    }
  }
}
