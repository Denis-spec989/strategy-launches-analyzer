<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.github.denisspec989</groupId>
	<artifactId>strategy-launches-analyzer</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<lombok.version>1.18.46</lombok.version>
		<spring-ai.version>2.0.0-M8</spring-ai.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.dataformat</groupId>
			<artifactId>jackson-dataformat-yaml</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>benchmark</id>
			<properties>
				<benchmark.models>gpt-4.1,gpt-5.5</benchmark.models>
				<benchmark.judge-model>gpt-5.6-sol</benchmark.judge-model>
				<benchmark.repetitions>3</benchmark.repetitions>
				<benchmark.concurrency>1</benchmark.concurrency>
				<benchmark.shuffle-seed>42</benchmark.shuffle-seed>
				<benchmark.resume-from></benchmark.resume-from>
				<benchmark.judge-calibration-report>target/judge-calibration/v2/report.json</benchmark.judge-calibration-report>
				<benchmark.judge-calibration-dataset>src/test/resources/evals/judge-calibration/v2/calibration-cases.jsonl</benchmark.judge-calibration-dataset>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-enforcer-plugin</artifactId>
						<version>3.5.0</version>
						<executions>
							<execution>
								<id>require-openai-api-key-for-benchmark</id>
								<phase>validate</phase>
								<goals>
									<goal>enforce</goal>
								</goals>
								<configuration>
									<rules>
										<requireEnvironmentVariable>
											<variableName>OPENAI_API_KEY</variableName>
											<message>OPENAI_API_KEY is required for the benchmark profile. Regular mvn test does not require it.</message>
										</requireEnvironmentVariable>
									</rules>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.5.5</version>
						<configuration>
							<includes>
								<include>**/AgentBenchmarkIT.java</include>
							</includes>
							<systemPropertyVariables>
								<benchmark.models>${benchmark.models}</benchmark.models>
								<benchmark.judge-model>${benchmark.judge-model}</benchmark.judge-model>
								<benchmark.repetitions>${benchmark.repetitions}</benchmark.repetitions>
								<benchmark.concurrency>${benchmark.concurrency}</benchmark.concurrency>
								<benchmark.shuffle-seed>${benchmark.shuffle-seed}</benchmark.shuffle-seed>
								<benchmark.resume-from>${benchmark.resume-from}</benchmark.resume-from>
								<benchmark.judge-calibration-report>${benchmark.judge-calibration-report}</benchmark.judge-calibration-report>
								<benchmark.judge-calibration-dataset>${benchmark.judge-calibration-dataset}</benchmark.judge-calibration-dataset>
							</systemPropertyVariables>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>judge-calibration</id>
			<properties>
				<judge-calibration.dataset>src/test/resources/evals/judge-calibration/v2/calibration-cases.jsonl</judge-calibration.dataset>
				<judge-calibration.results>target/judge-calibration/v2/results.jsonl</judge-calibration.results>
				<judge-calibration.judge-model>gpt-5.6-sol</judge-calibration.judge-model>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-enforcer-plugin</artifactId>
						<version>3.5.0</version>
						<executions>
							<execution>
								<id>require-openai-api-key-for-judge-calibration</id>
								<phase>validate</phase>
								<goals>
									<goal>enforce</goal>
								</goals>
								<configuration>
									<rules>
										<requireEnvironmentVariable>
											<variableName>OPENAI_API_KEY</variableName>
											<message>OPENAI_API_KEY is required for judge calibration. Regular mvn test does not require it.</message>
										</requireEnvironmentVariable>
									</rules>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.5.5</version>
						<configuration>
							<includes>
								<include>**/JudgeCalibrationIT.java</include>
							</includes>
							<systemPropertyVariables>
								<judge-calibration.dataset>${judge-calibration.dataset}</judge-calibration.dataset>
								<judge-calibration.results>${judge-calibration.results}</judge-calibration.results>
								<judge-calibration.judge-model>${judge-calibration.judge-model}</judge-calibration.judge-model>
							</systemPropertyVariables>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>benchmark-rejudge</id>
			<properties>
				<benchmark-rejudge.source>target/benchmark/20260813-120114-018</benchmark-rejudge.source>
				<benchmark-rejudge.judge-model>gpt-5.6-sol</benchmark-rejudge.judge-model>
				<benchmark-rejudge.judge-calibration-report>target/judge-calibration/v2/report.json</benchmark-rejudge.judge-calibration-report>
				<benchmark-rejudge.judge-calibration-dataset>src/test/resources/evals/judge-calibration/v2/calibration-cases.jsonl</benchmark-rejudge.judge-calibration-dataset>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-enforcer-plugin</artifactId>
						<version>3.5.0</version>
						<executions>
							<execution>
								<id>require-openai-api-key-for-benchmark-rejudge</id>
								<phase>validate</phase>
								<goals><goal>enforce</goal></goals>
								<configuration>
									<rules>
										<requireEnvironmentVariable>
											<variableName>OPENAI_API_KEY</variableName>
											<message>OPENAI_API_KEY is required for saved-response rejudge.</message>
										</requireEnvironmentVariable>
									</rules>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.5.5</version>
						<configuration>
							<includes><include>**/BenchmarkRejudgeIT.java</include></includes>
							<systemPropertyVariables>
								<benchmark-rejudge.source>${benchmark-rejudge.source}</benchmark-rejudge.source>
								<benchmark-rejudge.judge-model>${benchmark-rejudge.judge-model}</benchmark-rejudge.judge-model>
								<benchmark-rejudge.judge-calibration-report>${benchmark-rejudge.judge-calibration-report}</benchmark-rejudge.judge-calibration-report>
								<benchmark-rejudge.judge-calibration-dataset>${benchmark-rejudge.judge-calibration-dataset}</benchmark-rejudge.judge-calibration-dataset>
							</systemPropertyVariables>
						</configuration>
						<executions>
							<execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
