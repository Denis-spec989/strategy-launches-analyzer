<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.github.denisspec989</groupId>
	<artifactId>strategy-launches-analyzer</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<lombok.version>1.18.46</lombok.version>
		<spring-ai.version>2.0.0-M8</spring-ai.version>
		<gigachat-java.version>0.1.22</gigachat-java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-model</artifactId>
		</dependency>
		<dependency>
			<groupId>chat.giga</groupId>
			<artifactId>gigachat-java</artifactId>
			<version>${gigachat-java.version}</version>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.dataformat</groupId>
			<artifactId>jackson-dataformat-yaml</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>judge-selection</id>
			<properties>
				<model-selection.judge-models>GigaChat-3-Ultra,GigaChat-3.5-432B-A28B</model-selection.judge-models>
				<model-selection.calibration-dataset>src/test/resources/evals/judge-calibration/v2/calibration-cases.jsonl</model-selection.calibration-dataset>
				<model-selection.judge-output>target/model-selection/judges</model-selection.judge-output>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.5.5</version>
						<configuration>
							<includes><include>**/JudgeSelectionIT.java</include></includes>
							<systemPropertyVariables>
								<model-selection.judge-models>${model-selection.judge-models}</model-selection.judge-models>
								<model-selection.calibration-dataset>${model-selection.calibration-dataset}</model-selection.calibration-dataset>
								<model-selection.judge-output>${model-selection.judge-output}</model-selection.judge-output>
							</systemPropertyVariables>
						</configuration>
						<executions>
							<execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>model-selection</id>
			<properties>
				<model-selection.candidate-models>GigaChat-2-Max,GigaChat-3-Lightning,GigaChat-3-Pro,GigaChat-3-Ultra,GigaChat-3.5-432B-A28B</model-selection.candidate-models>
				<model-selection.judge-selection-report>target/model-selection/judges/selection.json</model-selection.judge-selection-report>
				<model-selection.output-base>target/model-selection/runs</model-selection.output-base>
				<model-selection.resume-from></model-selection.resume-from>
				<model-selection.pilot-repetitions>1</model-selection.pilot-repetitions>
				<model-selection.full-repetitions>3</model-selection.full-repetitions>
				<model-selection.finalists>3</model-selection.finalists>
				<model-selection.shuffle-seed>42</model-selection.shuffle-seed>
				<model-selection.minimum-semantic-gap>0.02</model-selection.minimum-semantic-gap>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.5.5</version>
						<configuration>
							<includes><include>**/AutomatedModelSelectionIT.java</include></includes>
							<systemPropertyVariables>
								<model-selection.candidate-models>${model-selection.candidate-models}</model-selection.candidate-models>
								<model-selection.judge-selection-report>${model-selection.judge-selection-report}</model-selection.judge-selection-report>
								<model-selection.output-base>${model-selection.output-base}</model-selection.output-base>
								<model-selection.resume-from>${model-selection.resume-from}</model-selection.resume-from>
								<model-selection.pilot-repetitions>${model-selection.pilot-repetitions}</model-selection.pilot-repetitions>
								<model-selection.full-repetitions>${model-selection.full-repetitions}</model-selection.full-repetitions>
								<model-selection.finalists>${model-selection.finalists}</model-selection.finalists>
								<model-selection.shuffle-seed>${model-selection.shuffle-seed}</model-selection.shuffle-seed>
								<model-selection.minimum-semantic-gap>${model-selection.minimum-semantic-gap}</model-selection.minimum-semantic-gap>
							</systemPropertyVariables>
						</configuration>
						<executions>
							<execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>benchmark</id>
			<properties>
				<benchmark.models></benchmark.models>
				<benchmark.judge-model></benchmark.judge-model>
				<benchmark.repetitions>3</benchmark.repetitions>
				<benchmark.concurrency>1</benchmark.concurrency>
				<benchmark.shuffle-seed>42</benchmark.shuffle-seed>
				<benchmark.resume-from></benchmark.resume-from>
				<benchmark.judge-calibration-report>target/judge-calibration/v2/report.json</benchmark.judge-calibration-report>
				<benchmark.judge-calibration-dataset>src/test/resources/evals/judge-calibration/v2/calibration-cases.jsonl</benchmark.judge-calibration-dataset>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.5.5</version>
						<configuration>
							<includes>
								<include>**/AgentBenchmarkIT.java</include>
							</includes>
							<systemPropertyVariables>
								<benchmark.models>${benchmark.models}</benchmark.models>
								<benchmark.judge-model>${benchmark.judge-model}</benchmark.judge-model>
								<benchmark.repetitions>${benchmark.repetitions}</benchmark.repetitions>
								<benchmark.concurrency>${benchmark.concurrency}</benchmark.concurrency>
								<benchmark.shuffle-seed>${benchmark.shuffle-seed}</benchmark.shuffle-seed>
								<benchmark.resume-from>${benchmark.resume-from}</benchmark.resume-from>
								<benchmark.judge-calibration-report>${benchmark.judge-calibration-report}</benchmark.judge-calibration-report>
								<benchmark.judge-calibration-dataset>${benchmark.judge-calibration-dataset}</benchmark.judge-calibration-dataset>
							</systemPropertyVariables>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>judge-calibration</id>
			<properties>
				<judge-calibration.dataset>src/test/resources/evals/judge-calibration/v2/calibration-cases.jsonl</judge-calibration.dataset>
				<judge-calibration.results>target/judge-calibration/v2/results.jsonl</judge-calibration.results>
				<judge-calibration.judge-model></judge-calibration.judge-model>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.5.5</version>
						<configuration>
							<includes>
								<include>**/JudgeCalibrationIT.java</include>
							</includes>
							<systemPropertyVariables>
								<judge-calibration.dataset>${judge-calibration.dataset}</judge-calibration.dataset>
								<judge-calibration.results>${judge-calibration.results}</judge-calibration.results>
								<judge-calibration.judge-model>${judge-calibration.judge-model}</judge-calibration.judge-model>
							</systemPropertyVariables>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>benchmark-rejudge</id>
			<properties>
				<benchmark-rejudge.source>target/benchmark/20260813-120114-018</benchmark-rejudge.source>
				<benchmark-rejudge.judge-model></benchmark-rejudge.judge-model>
				<benchmark-rejudge.judge-calibration-report>target/judge-calibration/v2/report.json</benchmark-rejudge.judge-calibration-report>
				<benchmark-rejudge.judge-calibration-dataset>src/test/resources/evals/judge-calibration/v2/calibration-cases.jsonl</benchmark-rejudge.judge-calibration-dataset>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.5.5</version>
						<configuration>
							<includes><include>**/BenchmarkRejudgeIT.java</include></includes>
							<systemPropertyVariables>
								<benchmark-rejudge.source>${benchmark-rejudge.source}</benchmark-rejudge.source>
								<benchmark-rejudge.judge-model>${benchmark-rejudge.judge-model}</benchmark-rejudge.judge-model>
								<benchmark-rejudge.judge-calibration-report>${benchmark-rejudge.judge-calibration-report}</benchmark-rejudge.judge-calibration-report>
								<benchmark-rejudge.judge-calibration-dataset>${benchmark-rejudge.judge-calibration-dataset}</benchmark-rejudge.judge-calibration-dataset>
							</systemPropertyVariables>
						</configuration>
						<executions>
							<execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>gigachat-certificate-smoke</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.5.5</version>
						<configuration>
							<includes>
								<include>**/GigaChatCertificateSmokeIT.java</include>
							</includes>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>gigachat-user-password-smoke</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.5.5</version>
						<configuration>
							<includes>
								<include>**/GigaChatUserPasswordSmokeIT.java</include>
							</includes>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
